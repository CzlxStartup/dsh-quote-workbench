{
  "name": "@local/quote-workbench",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "Quotation workbench for procurement, freight and profit analysis",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "service.js",
    "domain.js",
    "xlsx.js",
    "feishu.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "zod": "^4.1.12"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test *.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
